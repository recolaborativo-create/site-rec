---
export const prerender = false

// Página interna (não linkada, noindex) pra revisar e publicar empresas que
// se inscreveram pelo Google Form. Mesmo cookie `rec_mod` da /moderacao.
import { modPageGate } from '../utils/mod-auth'

const gate = modPageGate(Astro.request, Astro.url, '/cadastro-empresas')
if (gate) return gate

const SECTORS = [
  'beleza','saude','educacao','gastronomia','contabilidade','advocacia','marketing','tech',
  'consultoria','arquitetura','eventos','moda','imoveis','turismo','servicos','outro',
]
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Cadastro de empresas — REC</title>
  <style>
    :root { --bg:#0e1116; --card:#161b22; --line:rgba(255,255,255,0.12); --txt:#e8eef5; --muted:rgba(232,238,245,0.6); --teal:#2dd4c4; --red:#e06b6b; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--txt); font-family:system-ui,-apple-system,sans-serif; padding:24px; }
    h1 { font-size:1.4rem; margin:0 0 4px; }
    .sub { color:var(--muted); font-size:.9rem; margin:0 0 24px; }
    #status { margin-bottom:16px; font-size:.9rem; color:var(--muted); }
    .grid { display:grid; gap:20px; max-width:1100px; }
    .sub-card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:18px; display:grid; grid-template-columns:200px 1fr; gap:18px; }
    .logo-box { width:200px; height:130px; border-radius:10px; background:#fff; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .logo-box img { max-width:100%; max-height:100%; object-fit:contain; }
    .logo-box .noimg { color:#999; font-size:.75rem; text-align:center; padding:8px; }
    .hint { font-size:.74rem; color:var(--muted); margin:10px 0 0; line-height:1.5; }
    .fields { display:grid; grid-template-columns:repeat(2,1fr); gap:10px 14px; }
    .fields label { display:flex; flex-direction:column; gap:3px; font-size:.7rem; letter-spacing:.05em; text-transform:uppercase; color:var(--muted); }
    .fields .full { grid-column:1 / -1; }
    input, select, textarea { background:#0e1116; border:1px solid var(--line); color:var(--txt); border-radius:8px; padding:9px 11px; font-size:.9rem; font-family:inherit; width:100%; }
    textarea { resize:vertical; min-height:54px; }
    .row-check { flex-direction:row !important; align-items:center; gap:8px; text-transform:none; }
    .actions { grid-column:1 / -1; display:flex; gap:10px; margin-top:6px; }
    button { border:none; border-radius:999px; padding:11px 22px; font-weight:700; font-size:.85rem; cursor:pointer; }
    .pub { background:var(--teal); color:#04120f; }
    .dis { background:transparent; border:1px solid var(--line); color:var(--muted); }
    button:disabled { opacity:.5; cursor:default; }
    .msg { font-size:.82rem; margin-left:auto; align-self:center; }
    .ok { color:var(--teal); } .err { color:var(--red); }
    .empty { color:var(--muted); padding:40px 0; }
  </style>
</head>
<body>
  <h1>Cadastro de empresas</h1>
  <p class="sub">Inscrições do Google Form. Revise, ajuste segmento/alcance e publique. A logo é baixada e otimizada automaticamente.</p>
  <div id="status">carregando inscrições…</div>
  <div class="grid" id="grid"></div>

  <script define:vars={{ SECTORS }}>
    const grid = document.getElementById('grid')
    const statusEl = document.getElementById('status')
    const driveThumb = (ref) => {
      const m = String(ref).match(/[?&]id=([\w-]+)/) || String(ref).match(/\/d\/([\w-]+)/)
      const id = m ? m[1] : (/^[\w-]{20,}$/.test(ref) ? ref : null)
      return id ? `https://drive.google.com/thumbnail?id=${id}&sz=w400` : null
    }
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))

    function card(s) {
      const thumb = driveThumb(s.logoRef)
      const opts = SECTORS.map(x => `<option value="${x}">${x}</option>`).join('')
      const el = document.createElement('div')
      el.className = 'sub-card'
      el.dataset.key = s.key
      el.innerHTML = `
        <div>
          <div class="logo-box">${thumb ? `<img src="${thumb}" alt="" onerror="this.parentElement.innerHTML='<span class=noimg>logo não pôde ser pré-visualizada (mas será baixada ao publicar)</span>'"/>` : '<span class="noimg">sem logo detectada</span>'}</div>
          <p class="hint">${s.contactName ? '👤 ' + esc(s.contactName) : ''}${s.segment ? '<br>🏷️ ' + esc(s.segment) : ''}</p>
        </div>
        <div class="fields">
          <label>Identificador (slug)<input name="id" value="${esc(s.suggestedId)}"/></label>
          <label>Nome<input name="name" value="${esc(s.name)}"/></label>
          <label>Instagram<input name="instagram" value="${esc(s.instagram)}"/></label>
          <label>Segmento<select name="sector">${opts}</select></label>
          <label>Alcance (1-5)<input name="reach" type="number" min="1" max="5" value="3"/></label>
          <label>Cidade<input name="city" value="${esc(s.city)}"/></label>
          <label>WhatsApp (só dígitos)<input name="whatsapp" value="${esc(s.whatsapp)}"/></label>
          <label>Site<input name="website" value="${esc(s.website)}"/></label>
          <label class="row-check"><input name="hasGoogle" type="checkbox" ${s.hasGoogle ? 'checked' : ''}/> Tem Google Meu Negócio</label>
          <label class="full">Descrição<textarea name="description">${esc(s.description)}</textarea></label>
          <div class="actions">
            <button class="pub">publicar →</button>
            <button class="dis">ignorar</button>
            <span class="msg"></span>
          </div>
        </div>`
      // pré-seleciona o setor detectado pelo segmento (revisor ajusta se quiser)
      el.querySelector('[name=sector]').value = s.suggestedSector || 'outro'
      el.querySelector('.pub').onclick = () => publish(el, s)
      el.querySelector('.dis').onclick = () => dismiss(el, s)
      return el
    }

    function collect(el) {
      const v = (n) => el.querySelector(`[name=${n}]`)
      return {
        id: v('id').value.trim(),
        name: v('name').value.trim(),
        instagram: v('instagram').value.trim(),
        sector: v('sector').value,
        reach: v('reach').value,
        city: v('city').value.trim(),
        whatsapp: v('whatsapp').value.trim(),
        website: v('website').value.trim(),
        hasGoogle: v('hasGoogle').checked,
        description: v('description').value.trim(),
      }
    }

    async function publish(el, s) {
      const msg = el.querySelector('.msg')
      const btn = el.querySelector('.pub')
      btn.disabled = true; msg.className = 'msg'; msg.textContent = 'publicando…'
      const res = await fetch('/api/partner-intake/publish', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...collect(el), key: s.key, logoRef: s.logoRef }),
      })
      const data = await res.json().catch(() => ({}))
      if (res.ok && data.ok) { msg.className = 'msg ok'; msg.textContent = '✓ publicada'; setTimeout(() => el.remove(), 1200) }
      else { btn.disabled = false; msg.className = 'msg err'; msg.textContent = data.error || 'erro' }
    }

    async function dismiss(el, s) {
      const msg = el.querySelector('.msg')
      await fetch('/api/partner-intake/dismiss', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: s.key, name: s.name }),
      })
      el.remove()
    }

    async function load() {
      const res = await fetch('/api/partner-intake/list')
      const data = await res.json().catch(() => ({}))
      if (!res.ok) { statusEl.className = 'err'; statusEl.textContent = data.error || 'erro ao carregar'; return }
      if (!data.pending.length) { statusEl.textContent = ''; grid.innerHTML = '<p class="empty">Nenhuma inscrição pendente. 🎉</p>'; return }
      statusEl.textContent = `${data.count} inscrição(ões) pendente(s)`
      data.pending.forEach(s => grid.appendChild(card(s)))
    }
    load()
  </script>
</body>
</html>
