---
// Carrossel infinito de logos de empresas atendidas pelo HUB.
// Marquee em CSS puro (sem JS) — funciona idêntico em desktop e mobile.
// Não-clicável: é só exibição/prova social.
// scale = multiplicador da altura base, pra equalizar o PESO ÓPTICO.
// Logos "densas" (2 linhas, arte compacta) ganham mais altura pra a marca
// não ficar miúda perto das de uma linha só.
const clients = [
  { name: 'Open Imobiliária', file: 'open-imobiliaria' },
  { name: 'Agafarma', file: 'agafarma', scale: 1.28 },
  { name: 'OK Arquitetura', file: 'ok-arquitetura' },
  { name: 'NOCA Porto Alegre', file: 'noca-porto-alegre', scale: 1.1 },
  { name: 'Balloons', file: 'balloons' },
  { name: 'Raupp Consultoria Contábil', file: 'raupp' },
  { name: 'Educação Adventista', file: 'educacao-adventista' },
  { name: 'Geração Água', file: 'geracao-agua', scale: 1.24 },
  { name: 'Italínea Conceito', file: 'italinea-conceito' },
  { name: 'Sanar Farmácias', file: 'sanar', scale: 1.12 },
  { name: 'Guacamole', file: 'guacamole' },
  { name: 'Dra. Regiane Pereira', file: 'regiane-pereira' },
  { name: 'Andréia Longaray', file: 'andreia-longaray' },
  { name: 'Lumbiezi', file: 'lumbiezi' },
  { name: 'O Guia Imóveis', file: 'o-guia-imoveis' },
  { name: 'Mistura Farmácia', file: 'mistura', scale: 1.3 },
  { name: 'Sua Casa Imóveis', file: 'sua-casa' },
  { name: 'Andressa Boneto Contabilidade', file: 'andressa-boneto', scale: 1.08 },
  { name: 'Ótica Guria Bonita', file: 'otica-guria-bonita' },
  { name: 'Italínea Casa Bonita', file: 'italinea-casa-bonita', scale: 1.18 },
  { name: 'Trevo Locações', file: 'trevo-locacoes', scale: 1.2 },
]
// Duplica a lista pra o loop ficar seamless (translateX -50%).
const loop = [...clients, ...clients]
---

<section class="hub-clients" aria-label="Empresas atendidas pelo HUB">
  <header class="hub-clients-head" data-reveal>
    <span class="hub-eyebrow hub-eyebrow-dark">portfólio</span>
    <h2>Marcas que já <em>cresceram</em> com o HUB.</h2>
    <p>Empresas que confiaram na estratégia da rede e seguem em movimento.</p>

    <div class="hub-clients-modes" data-clients-toggle role="group" aria-label="modo de exibição">
      <button class="hcm-btn active" data-mode="carousel" type="button" aria-pressed="true" title="Carrossel">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12h13"/><path d="M12 7l5 5-5 5"/><path d="M20 6v12"/>
        </svg>
        <span>carrossel</span>
      </button>
      <button class="hcm-btn" data-mode="grid" type="button" aria-pressed="false" title="Grade">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>grade</span>
      </button>
    </div>
  </header>

  <div class="hub-clients-track" data-reveal>
    <div class="hub-clients-belt" role="list">
      {loop.map((c, i) => (
        <div class="hub-client" role={i < clients.length ? 'listitem' : 'presentation'} aria-hidden={i >= clients.length ? 'true' : undefined} style={c.scale ? `--logo-scale:${c.scale}` : undefined}>
          <img src={`/clientes/${c.file}.png`} alt={i < clients.length ? c.name : ''} loading="eager" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hub-clients {
    padding: var(--space-20) 0;
    background: var(--surface);
    overflow: hidden;
  }
  .hub-clients-head {
    max-width: 720px;
    margin: 0 auto var(--space-12);
    text-align: center;
    padding: 0 var(--space-6);
  }
  .hub-clients-head h2 {
    font-family: var(--font-display);
    color: var(--rec-blue);
    margin: var(--space-3) 0 var(--space-2);
  }
  .hub-clients-head h2 em {
    font-style: italic;
    color: var(--rec-teal);
  }
  .hub-clients-head p {
    color: var(--text);
    opacity: 0.7;
  }
  /* Dark mode: texto do cabeçalho precisa clarear */
  :global(html[data-theme='dark']) .hub-clients-head h2 { color: var(--text-strong); }
  :global(html[data-theme='dark']) .hub-clients-head h2 em { color: var(--accent); }

  /* Toggle carrossel / grade */
  .hub-clients-modes {
    display: inline-flex;
    gap: 2px;
    margin-top: var(--space-5);
    padding: 4px;
    background: rgba(1, 38, 89, 0.05);
    border: 1px solid rgba(1, 38, 89, 0.08);
    border-radius: 11px;
  }
  :global(html[data-theme='dark']) .hub-clients-modes {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .hcm-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 200ms ease, background 200ms ease;
  }
  .hcm-btn:hover { color: var(--text); }
  .hcm-btn.active {
    color: var(--rec-teal);
    background: var(--surface-raised);
    box-shadow: 0 2px 6px rgba(1, 38, 89, 0.1);
  }
  :global(html[data-theme='dark']) .hcm-btn.active { color: var(--accent); }
  .hcm-btn svg { flex-shrink: 0; }

  /* Trilho com fade nas bordas — via pseudo-elementos (NÃO mask-image:
     mask + animation pisca/some no iOS Safari). */
  .hub-clients-track {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .hub-clients-track::before,
  .hub-clients-track::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 9%;
    z-index: 2;
    pointer-events: none;
  }
  .hub-clients-track::before { left: 0; background: linear-gradient(to right, var(--surface), transparent); }
  .hub-clients-track::after { right: 0; background: linear-gradient(to left, var(--surface), transparent); }

  .hub-clients-belt {
    display: flex;
    width: max-content;
    animation: hub-clients-scroll 56s linear infinite;
    /* estabiliza a composição GPU — evita o iOS descartar a camada
       e a fita "sumir e voltar" durante o loop */
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* Pausa ao passar o mouse (desktop) */
  .hub-clients-track:hover .hub-clients-belt {
    animation-play-state: paused;
  }

  .hub-client {
    flex: 0 0 auto;
    /* largura auto: o card se ajusta à largura natural da logo.
       altura de logo uniforme (abaixo) garante peso visual igual. */
    width: auto;
    height: 104px;
    margin: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 32px;
    background: #fff;
    border: 1px solid rgba(1, 38, 89, 0.08);
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(1, 38, 89, 0.04);
  }
  .hub-client img {
    /* altura base uniforme × scale por-logo (peso óptico).
       teto de largura impede que logos muito largas virem faixa. */
    height: calc(52px * var(--logo-scale, 1));
    width: auto;
    max-width: 172px;
    object-fit: contain;
    filter: saturate(0.96);
  }

  @keyframes hub-clients-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* ===== Modo GRADE (estático) ===== */
  .hub-clients.is-grid .hub-clients-track { overflow: visible; padding: 0 var(--space-6); }
  .hub-clients.is-grid .hub-clients-track::before,
  .hub-clients.is-grid .hub-clients-track::after { display: none; }
  .hub-clients.is-grid .hub-clients-belt {
    animation: none;
    transform: none;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    max-width: 1100px;
    margin: 0 auto;
  }
  /* esconde as cópias duplicadas (só servem pro loop do carrossel) */
  .hub-clients.is-grid .hub-client[aria-hidden='true'] { display: none; }
  .hub-clients.is-grid .hub-client { margin: 0; }

  /* Respeita quem prefere menos movimento */
  @media (prefers-reduced-motion: reduce) {
    .hub-clients-belt { animation: none; flex-wrap: wrap; justify-content: center; width: 100%; }
  }

  /* Mobile: cards menores e fita um pouco mais rápida */
  @media (max-width: 640px) {
    .hub-clients { padding: var(--space-16) 0; }
    .hub-client {
      height: 82px;
      margin: 0 7px;
      padding: 0 22px;
      border-radius: 14px;
    }
    .hub-client img { height: calc(40px * var(--logo-scale, 1)); max-width: 132px; }
    .hub-clients-belt { animation-duration: 42s; }
    .hub-clients-track::before,
    .hub-clients-track::after { width: 7%; }
  }
</style>

<script>
  // Toggle carrossel ↔ grade (persiste a escolha)
  const section = document.querySelector<HTMLElement>('.hub-clients')
  const toggle = document.querySelector<HTMLElement>('[data-clients-toggle]')
  if (section && toggle) {
    const btns = toggle.querySelectorAll<HTMLButtonElement>('.hcm-btn')
    const apply = (mode: string, persist = true) => {
      section.classList.toggle('is-grid', mode === 'grid')
      btns.forEach(b => {
        const active = b.dataset.mode === mode
        b.classList.toggle('active', active)
        b.setAttribute('aria-pressed', String(active))
      })
      if (persist) { try { localStorage.setItem('rec.hub.clients-view', mode) } catch {} }
    }
    btns.forEach(b => b.addEventListener('click', () => apply(b.dataset.mode || 'carousel')))
    try {
      const saved = localStorage.getItem('rec.hub.clients-view')
      if (saved === 'grid') apply('grid', false)
    } catch {}
  }
</script>
