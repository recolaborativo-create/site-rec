---
import '../styles/globals.css'
import SeoHead from '../components/seo/SeoHead.astro'
import AdaptiveNav from '../components/nav/AdaptiveNav.astro'
import NavDrawer from '../components/nav/NavDrawer.astro'
import ManifestoFooter from '../components/footer/ManifestoFooter.astro'

interface Props {
  title: string
  description: string
  path: string
  currentSection?: string
  /** Schemas JSON-LD adicionais (Event, BlogPosting, BreadcrumbList…) injetados no <head> */
  schemas?: Array<Record<string, unknown>>
  /** URL de imagem a pré-carregar com alta prioridade (ex: poster do hero, elemento LCP) */
  preloadImage?: string
}
const { title, description, path, currentSection, schemas, preloadImage } = Astro.props
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Tema: aplica antes do paint pra evitar flash de cor errada */}
  <script is:inline>
    (function () {
      try {
        // Padrão é SEMPRE light. Só fica dark se a pessoa escolheu antes (clique no toggle).
        if (localStorage.getItem('rec-theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark')
        }
      } catch (e) {}
    })()
  </script>
  <SeoHead {title} {description} {path} {schemas} />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,200;0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,300;1,9..144,400;1,9..144,600;1,9..144,700&family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,200;0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,300;1,9..144,400;1,9..144,600;1,9..144,700&family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,200;0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,300;1,9..144,400;1,9..144,600;1,9..144,700&family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </noscript>
</head>
<body>
  <AdaptiveNav current={currentSection} />
  <NavDrawer current={currentSection} />
  <main>
    <slot />
  </main>
  <ManifestoFooter />
  <!-- Meta Pixel (Facebook) — só inicializa depois que a página terminar de carregar, pra não competir com o conteúdo principal -->
  <script is:inline>
    window.addEventListener('load', function () {
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init','2183751455318866');
      fbq('track','PageView');
    });
  </script>
  <!-- Google Analytics GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7KFTLNZC8V" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-7KFTLNZC8V');

    // qualify_lead: dispara em qualquer clique que leve ao WhatsApp do REC (mesmo gatilho do "Fale conosco")
    document.addEventListener('click', function (e) {
      const link = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
      if (link) gtag('event', 'qualify_lead');
    });
  </script>
</body>
</html>
